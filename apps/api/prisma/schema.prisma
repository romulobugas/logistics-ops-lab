// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StockActivityStatus {
  PENDING
  IN_PROGRESS
  FINALIZED
}

enum StockReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum StockActivityType {
  IN
  OUT
  TRANSFER
  RESERVE
  RELEASE
  ADJUSTMENT
}

// ==================================================================
// Product & SKU Management
// ==================================================================

model Product {
  id                     String    @id @default(cuid())
  code                   String    @unique
  name                   String
  depositor              String?   // Depositante
  supplier               String?   // Fornecedor
  productType            String?   // Tipo de Produto
  sanitaryClassification String?   // Classificação Sanitária
  shelfLifeDays          Int?      // Shelf Life (Dias)
  usefulLifeDays         Int?      // Vida útil (Dias)
  quarantineDays         Int?      // Dias de Quarentena
  minStockLevel          Int?      // Nível Mínimo de Armazenagem
  maxStockLevel          Int?      // Nível Máximo de Armazenagem
  isActive               Boolean   @default(true)
  controlsExpiry         Boolean   @default(false) // Controla Validade
  closedPanel            Boolean   @default(false) // Painel Fechado
  showOnEntryNote        Boolean   @default(false) // Exibir item na Nota de Entrada
  makesOrder             Boolean   @default(false) // Faz pedido
  controlsBatch          Boolean   @default(false) // Controla Lote
  gridSewing             Boolean   @default(false) // Costura Grade
  quarantine             Boolean   @default(false) // Quarentena
  dynamicPicking         Boolean   @default(false) // Picking Dinâmico
  separationMagnitude    Boolean   @default(false) // Grandeza na Separação
  informExpiryOnCheck    Boolean   @default(false) // Informar validade na conferência
  isProductKit           Boolean   @default(false) // Kit de Produto
  specialComposition     Boolean   @default(false) // Composição Especial
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  skus                   SKU[]
  productGroupId         String?
  storageGroupId         String?
  baseUnitId             String?
  entryUnitId            String?
  storageUnitId          String?
  pickingUnitId          String?
  altPickingUnitId       String?
  productGroup           ProductGroup? @relation(fields: [productGroupId], references: [id])
  storageGroup           StorageGroup? @relation(fields: [storageGroupId], references: [id])
  baseUnit               Unit?         @relation("BaseUnit", fields: [baseUnitId], references: [id])
  entryUnit              Unit?         @relation("EntryUnit", fields: [entryUnitId], references: [id])
  storageUnit            Unit?         @relation("StorageUnit", fields: [storageUnitId], references: [id])
  pickingUnit            Unit?         @relation("PickingUnit", fields: [pickingUnitId], references: [id])
  altPickingUnit         Unit?         @relation("AltPickingUnit", fields: [altPickingUnitId], references: [id])

  @@map("products")
}

model SKU {
  id                 String    @id @default(cuid())
  ean                String?   @unique // Código de Barra
  unitId             String              // Unidade
  conversionFactor   Float     @default(1) // Qt. por Embalagem
  brand              String?             // Marca
  color              String?             // Cor
  size               String?             // Tamanho
  weightKg           Float?              // Peso (KG)
  volumeM3           Float?              // Vol
  heightCm           Float?              // Altura (cm)
  widthCm            Float?              // Largura (cm)
  lengthCm           Float?              // Comprimento (cm)
  standardPallet     String?             // Palete Padrão
  standardBox        String?             // Caixa Padrão
  maxHeightCm        Float?              // Altura Máxima (CX/Unid)
  palletizing        Int?                // Paletização
  lastro             Int?                // Lastro
  recipientType      String?             // Tipo de Recipiente
  allowBarcodeZero   Boolean   @default(false)
  allowConsignated   Boolean   @default(false)
  allowOverlap       Boolean   @default(false)
  allowTumble        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  productId          String
  product            Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit               Unit        @relation(fields: [unitId], references: [id])
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  stockLots          StockLot[]
  stockReservations  StockReservation[]
  stockActivities    StockActivity[]

  @@map("skus")
}

model Unit {
  id           String   @id @default(cuid())
  name         String   @unique
  abbreviation String   @unique
  createdAt    DateTime @default(now())

  // Relations
  skus         SKU[]
  baseProducts Product[] @relation("BaseUnit")
  entryProducts Product[] @relation("EntryUnit")
  storageProducts Product[] @relation("StorageUnit")
  pickingProducts Product[] @relation("PickingUnit")
  altPickingProducts Product[] @relation("AltPickingUnit")

  @@map("units")
}

model ProductGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // Relations
  products    Product[]

  @@map("product_groups")
}

model StorageGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // Relations
  products    Product[]

  @@map("storage_groups")
}

model StockBalance {
  id          String   @id @default(cuid())
  skuId       String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  sku SKU @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([skuId])
  @@map("stock_balances")
}

model StockMovement {
  id        String   @id @default(cuid())
  skuId     String
  lotId     String?
  locationId String?
  destinationLocationId String?
  type      String   // IN, OUT, TRANSFER, ADJUSTMENT
  quantity  Int
  reason    String
  createdAt DateTime @default(now())

  sku      SKU            @relation(fields: [skuId], references: [id], onDelete: Cascade)
  lot      StockLot?      @relation(fields: [lotId], references: [id], onDelete: SetNull)
  location StockLocation? @relation("StockMovementSource", fields: [locationId], references: [id], onDelete: SetNull)
  destinationLocation StockLocation? @relation("StockMovementDestination", fields: [destinationLocationId], references: [id], onDelete: SetNull)

  @@map("stock_movements")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  firstName String
  lastName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles         UserRole[]
  accessLogs        AccessLog[]
  assignedActivities StockActivity[] @relation("AssignedActivities")
  createdActivities  StockActivity[] @relation("CreatedActivities")
  activeOperator     ActiveOperator?

  @@map("users")
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  resource    String // ex: 'users', 'stock', 'reports'
  action      String // ex: 'create', 'read', 'update', 'delete'
  isActive    Boolean @default(true)

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RoutePermission {
  id           String @id @default(cuid())
  role         String
  route        String
  method       String
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())

  @@unique([role, route, method])
  @@map("route_permissions")
}

model AccessLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // LOGIN, LOGOUT, ACCESS_DENIED, etc.
  resource  String?  // endpoint accessed
  method    String?  // HTTP method
  ip        String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("access_logs")
}

model StockLocation {
  id        String   @id @default(cuid())
  deposit   String   // Depósito
  street    String   // Rua
  block     String   // Bloco
  level     String   // Nível
  apartment String   // Apartamento
  createdAt DateTime @default(now())

  lots      StockLot[]
  activities StockActivity[] @relation("ActivitySourceLocation")
  destinationActivities StockActivity[] @relation("ActivityDestinationLocation")
  movements StockMovement[] @relation("StockMovementSource")
  destinationMovements StockMovement[] @relation("StockMovementDestination")

  @@unique([deposit, street, block, level, apartment])
  @@map("stock_locations")
}

model StockLot {
  id               String   @id @default(cuid())
  skuId            String
  locationId       String
  lotCode          String?  // Lote opcional
  expiryDate       DateTime? // Validade opcional
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sku          SKU           @relation(fields: [skuId], references: [id], onDelete: Cascade)
  location     StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  reservations StockReservation[]
  activities   StockActivity[]
  movements    StockMovement[]

  @@map("stock_lots")
}

model StockReservation {
  id          String                 @id @default(cuid())
  skuId       String
  lotId       String?
  quantity    Int
  status      StockReservationStatus @default(PENDING)
  referenceId String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  sku SKU @relation(fields: [skuId], references: [id], onDelete: Cascade)
  lot StockLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)
  activities StockActivity[]

  @@map("stock_reservations")
}

model StockActivity {
  id            String              @id @default(cuid())
  type          StockActivityType
  status        StockActivityStatus @default(PENDING)
  skuId         String
  lotId         String?
  locationId    String?
  destinationLocationId String?
  reservationId String?
  quantity      Int
  assignedUserId String?
  createdByUserId String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  completedAt   DateTime?

  sku         SKU              @relation(fields: [skuId], references: [id], onDelete: Cascade)
  lot         StockLot?        @relation(fields: [lotId], references: [id], onDelete: SetNull)
  location    StockLocation?   @relation("ActivitySourceLocation", fields: [locationId], references: [id], onDelete: SetNull)
  destinationLocation StockLocation? @relation("ActivityDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: SetNull)
  reservation StockReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  assignedUser User?           @relation("AssignedActivities", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdByUser User?          @relation("CreatedActivities", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@map("stock_activities")
}

model ActiveOperator {
  id         String   @id @default(cuid())
  userId     String
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @updatedAt
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("active_operators")
}
